# Copie para .env e ajuste. O .env fica fora do Git (RNF04).
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yummi

SECRET_KEY=troque-esta-chave-em-producao
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1

# Envio de e-mail (codigo de verificacao).
# Sem SMTP_USER e SMTP_PASSWORD o codigo aparece no log do backend.
# No Gmail, gere uma "senha de app" em https://myaccount.google.com/apppasswords
# (exige verificacao em duas etapas ativada). Nao use a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Yummi <seu-email@gmail.com>
