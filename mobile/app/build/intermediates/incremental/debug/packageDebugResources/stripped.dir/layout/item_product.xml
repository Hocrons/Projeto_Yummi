<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/yummi_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Foto -->
        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_product_image"
            android:src="@drawable/ic_food_placeholder"
            android:contentDescription="Foto do produto"/>

        <!-- Dados -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/yummi_text"/>

            <TextView
                android:id="@+id/tvDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/yummi_muted"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvPreco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/yummi_primary"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDisponivel"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:textSize="11sp"
                    android:textColor="@color/yummi_text"
                    app:chipMinHeight="28dp"
                    app:chipStartPadding="8dp"
                    app:chipEndPadding="8dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Ações -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconSize="16dp"
                app:iconPadding="0dp"
                app:strokeColor="@color/yummi_primary"
                app:iconTint="@color/yummi_primary"
                android:contentDescription="Editar"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginTop="6dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconSize="16dp"
                app:iconPadding="0dp"
                app:strokeColor="@color/yummi_error"
                app:iconTint="@color/yummi_error"
                android:contentDescription="Remover"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
