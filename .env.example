# Renomeie este arquivo para .env e ajuste os valores
SECRET_KEY=troque-esta-chave-em-producao
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha
DB_NAME=yummy
FLASK_DEBUG=1

# --- Login social (opcional) ---
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI autorizado: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps
#   Redirect URI válido: http://localhost:5000/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Envio de código de verificação por e-mail (SMTP) ---
# Com Gmail: ative a verificação em 2 etapas na sua conta e gere uma
# "senha de app" em https://myaccount.google.com/apppasswords
# (não use a senha normal da sua conta Google aqui).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMETENTE_NOME=Yummy

# --- Envio de código via WhatsApp (automação não oficial, whatsapp-web.js) ---
# Suba o microsserviço em whatsapp-service/ (veja o README dessa pasta).
# Não precisa de token nem de conta comercial - só rodar o processo Node
# e escanear o QR Code uma vez com o número 11959913833.
WHATSAPP_LOCAL_API_URL=http://localhost:3001